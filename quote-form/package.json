{
  "name": "quote-form",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ui": "vitest run --ui",
    "build:qa": "vue-tsc -b && vite build --mode qa",
    "build:qa2": "vue-tsc -b && vite build --mode qa2",
    "build:qa-gantry": "vue-tsc -b && vite build --mode qa-gantry",
    "build:staging": "vue-tsc -b && vite build --mode staging",
    "build": "vue-tsc -b && vite build",
    "build-local": "vue-tsc -b && vite build --mode wordpress",
    "build-local-send": "npm run build-local && mc cp ./dist/assets/quote-form-app.js local/quote-form-v2/local/assets/ && mc cp ./dist/assets/quote-form-app.css local/quote-form-v2/local/assets/ && echo 'Deployed!'"
  },
  "dependencies": {
    "@datadog/browser-rum": "^6.26.0",
    "@heroicons/vue": "^2.2.0",
    "@insuremytrip/imt-com-apps-api-client": "^1.0.3",
    "@primeuix/themes": "^2.0.2",
    "@primevue/forms": "^4.5.4",
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.1.0",
    "daisyui": "^5.5.14",
    "dayjs": "^1.11.11",
    "inputmask": "^5.0.9",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.24",
    "vue-gtag": "^3.6.3",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/inputmask": "^5.0.7",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^2.1.8",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "jsdom": "^25.0.1",
    "less": "^4.5.1",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-vue": "^1.1.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.1.4"
  }
}
