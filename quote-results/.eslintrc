{
  "parser": "vue-eslint-parser",
  "env": {
    "node": true,
    "browser": true,
    "commonJS": true,
    "es6": true
  },
  "extends": [
    "plugin:vue/base",
    "eslint:recommended",
    "plugin:vue/vue3-recommended",
    "prettier"
  ],
  "rules": {
    "semi": [2, "always"],
    "comma-dangle": ["error", {
      "arrays": "never",
      "objects": "always"
    }],
    "vue/multi-word-component-names": "off"
  }
}
